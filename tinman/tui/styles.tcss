/* Tinman TUI - Terminal Card Theme */

$bg: #070a0f;
$bg-soft: #0a111a;
$panel: 50%;
$panel-bg: #0d141e;
$panel-strong-bg: #0b121b;
$border: #1f2a3a;
$border-strong: #2a3a52;
$text: #e6edf3;
$muted: #8a99b2;
$accent: #38d996;
$accent-strong: #00c389;
$accent-cool: #7bdcff;
$danger: #ff4d4f;
$warning: #f2b650;
$success: #22d37f;
$glow: #00f5b8;

Screen {
    background: $bg;
    color: $text;
}

#main-container {
    width: 100%;
    height: 100%;
    background: $bg;
}

#header {
    height: 6;
    width: 100%;
    background: $panel-strong-bg;
    border: tall $border-strong;
    padding: 0 2;
}

#header Static {
    color: $accent;
    text-style: bold;
}

#ascii-logo {
    color: $accent;
}

#status-line Static {
    color: $muted;
}

#status-line {
    dock: right;
    width: auto;
    height: 3;
    padding-right: 2;
}

#version {
    color: $accent-cool;
}

#nav-bar {
    height: 3;
    width: 100%;
    background: $panel-bg;
    border: solid $border;
    padding: 0 1;
}

#nav-bar Button {
    background: transparent;
    color: $text;
    border: none;
    min-width: 14;
    margin: 0 1;
}

Button {
    color: $text;
}

.cta-row Button {
    min-width: 16;
    height: 3;
    content-align: center middle;
    border: round $border-strong;
    background: $panel-bg;
    text-style: bold;
}

#start-run {
    background: $success;
    color: $bg;
    text-style: bold;
}

#stop-run {
    background: $danger;
    color: $bg;
    text-style: bold;
}

#nav-bar Button:hover {
    background: $panel-strong-bg;
    color: $accent;
}

#nav-bar Button:focus {
    background: $panel-strong-bg;
    color: $accent;
    text-style: bold;
}

#nav-bar Button.-active {
    background: $panel-strong-bg;
    color: $accent;
    text-style: bold;
    border: round $accent;
}

#content {
    width: 100%;
    height: 1fr;
    background: $bg;
}

.panel-title {
    color: $text;
    text-style: bold;
    background: $panel-bg;
    padding: 0 1;
    border: round $border-strong;
}

#activity-log {
    height: 100%;
    border: round $border;
    background: $panel-strong-bg;
    padding: 1;
}

.progress-label {
    color: $muted;
}

DataTable {
    height: 1fr;
    background: $panel-bg;
    border: round $border;
}

DataTable > .datatable--header {
    background: $panel-strong-bg;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent-strong;
    color: $bg;
}

#chat-log {
    height: 1fr;
    border: round $border;
    background: $panel-strong-bg;
    padding: 1;
    margin-bottom: 1;
}

#chat-input {
    height: 3;
    border: round $border-strong;
    background: $panel-bg;
    color: $text;
}

#chat-input:focus {
    border: round $accent-cool;
}

.user-message {
    color: $accent;
    margin-bottom: 1;
}

.assistant-message {
    color: $text;
    margin-bottom: 1;
}

.empty-state {
    color: $muted;
    text-align: center;
    padding: 1;
}

#approval-modal {
    align: center middle;
    width: 74;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $panel-bg;
    padding: 1 2;
}

#approval-modal .modal-title {
    color: $accent;
    text-style: bold;
    text-align: center;
    padding-bottom: 1;
}

#approval-modal .modal-content {
    color: $text;
    padding: 1 0;
}

#approval-modal .modal-actions {
    layout: horizontal;
    align: center middle;
    height: auto;
    padding-top: 1;
}

#approval-modal Button {
    margin: 0 2;
    min-width: 12;
}

#approval-modal #approve-btn {
    background: $success;
    color: $bg;
    border: solid $success;
}

#approval-modal #reject-btn {
    background: $danger;
    color: $bg;
    border: solid $danger;
}

#approval-modal #details-btn {
    background: $panel-strong-bg;
    color: $accent;
    border: round $accent;
}

#footer {
    height: 3;
    width: 100%;
    background: $panel-bg;
    border: solid $border;
    padding: 0 1;
}

#footer Static {
    color: $muted;
}

.metric-label {
    color: $muted;
}

.metric-value {
    color: $accent;
    text-style: bold;
}

Scrollbar {
    background: $panel-strong-bg;
}

ScrollbarSlider {
    background: $border;
}

ScrollbarSlider:hover {
    background: $accent;
}

LoadingIndicator {
    color: $accent;
}
.status-muted {
    color: $muted;
}

.status-ok {
    color: $success;
    text-style: bold;
}

.status-warn {
    color: $warning;
}
