/* Tinman TUI - Bold Branded Theme */

$bg: #0b0f14;
$bg-soft: #0f172a;
$panel: 50%;
$panel-bg: #121826;
$panel-strong-bg: #0b1220;
$border: #243047;
$text: #e5e7eb;
$muted: #8b98b8;
$accent: #ffb020;
$accent-strong: #ff8a00;
$accent-cool: #7dd3fc;
$danger: #ff4d4f;
$warning: #f5a524;
$success: #22c55e;

Screen {
    background: $bg;
    color: $text;
}

#main-container {
    width: 100%;
    height: 100%;
    background: $bg;
}

#header {
    height: 7;
    width: 100%;
    background: $panel-strong-bg;
    border: tall $border;
    padding: 0 2;
}

#header Static {
    color: $accent;
    text-style: bold;
}

#status-line {
    dock: right;
    width: auto;
    height: 3;
    padding-right: 2;
}

#version {
    color: $accent-cool;
}

#nav-bar {
    height: 3;
    width: 100%;
    background: $panel-bg;
    border: solid $border;
    padding: 0 1;
}

#nav-bar Button {
    background: transparent;
    color: $text;
    border: none;
    min-width: 16;
    margin: 0 1;
}

#nav-bar Button:hover {
    background: $panel-strong-bg;
    color: $accent;
}

#nav-bar Button:focus {
    background: $panel-strong-bg;
    color: $accent;
    text-style: bold;
}

#nav-bar Button.-active {
    background: $accent-strong;
    color: $bg;
    text-style: bold;
}

#content {
    width: 100%;
    height: 1fr;
    background: $bg;
}

.panel-title {
    color: $text;
    text-style: bold;
    background: $panel-bg;
    padding: 0 1;
    border: round $border;
}

#activity-log {
    height: 100%;
    border: solid $border;
    background: $panel-strong-bg;
    padding: 1;
}

.progress-label {
    color: $muted;
}

DataTable {
    height: 1fr;
    background: $panel-bg;
    border: solid $border;
}

DataTable > .datatable--header {
    background: $panel-strong-bg;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent-strong;
    color: $bg;
}

#chat-log {
    height: 1fr;
    border: solid $border;
    background: $panel-strong-bg;
    padding: 1;
    margin-bottom: 1;
}

#chat-input {
    height: 3;
    border: solid $accent;
    background: $panel-bg;
    color: $text;
}

#chat-input:focus {
    border: solid $accent-cool;
}

.user-message {
    color: $accent;
    margin-bottom: 1;
}

.assistant-message {
    color: $text;
    margin-bottom: 1;
}

.empty-state {
    color: $muted;
    text-align: center;
    padding: 1;
}

#approval-modal {
    align: center middle;
    width: 72;
    height: auto;
    max-height: 80%;
    border: double $accent-strong;
    background: $panel-bg;
    padding: 1 2;
}

#approval-modal .modal-title {
    color: $accent;
    text-style: bold;
    text-align: center;
    padding-bottom: 1;
}

#approval-modal .modal-content {
    color: $text;
    padding: 1 0;
}

#approval-modal .modal-actions {
    layout: horizontal;
    align: center middle;
    height: auto;
    padding-top: 1;
}

#approval-modal Button {
    margin: 0 2;
    min-width: 12;
}

#approval-modal #approve-btn {
    background: $success;
    color: $bg;
    border: solid $success;
}

#approval-modal #reject-btn {
    background: $danger;
    color: $bg;
    border: solid $danger;
}

#approval-modal #details-btn {
    background: $panel-strong-bg;
    color: $accent;
    border: solid $accent;
}

#footer {
    height: 3;
    width: 100%;
    background: $panel-bg;
    border: solid $border;
    padding: 0 1;
}

#footer Static {
    color: $muted;
}

.metric-label {
    color: $muted;
}

.metric-value {
    color: $accent;
    text-style: bold;
}

Scrollbar {
    background: $panel-strong-bg;
}

ScrollbarSlider {
    background: $border;
}

ScrollbarSlider:hover {
    background: $accent;
}

LoadingIndicator {
    color: $accent;
}
.status-muted {
    color: $muted;
}

.status-ok {
    color: $success;
    text-style: bold;
}

.status-warn {
    color: $warning;
}
