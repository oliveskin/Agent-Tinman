/* Tinman TUI - Terminal Card Theme (ASCII-safe) */

$bg: #05070b;
$frame: #0b1119;
$surface: #0f1722;
$surface-2: #121b28;
$border: #1f2a39;
$border-strong: #2c3a4f;
$text: #e6edf3;
$muted: #8b9ab2;
$accent: #31e8a9;
$accent-strong: #15c990;
$accent-cool: #6fd6ff;
$danger: #ff5c5f;
$warning: #f6c453;
$success: #2ee59d;

Screen {
    background: $bg;
    color: $text;
}

#main-container {
    width: 100%;
    height: 100%;
    background: $bg;
    padding: 1 2;
}

#terminal-frame {
    width: 100%;
    height: 100%;
    background: $frame;
    border: round $border-strong;
    padding: 1 1;
}

#window-bar {
    height: 3;
    width: 100%;
    background: $surface;
    border: round $border;
    padding: 0 1;
}

#window-controls {
    width: 6;
    color: $warning;
    text-style: bold;
}

#window-title {
    width: 1fr;
    content-align: center middle;
    color: $muted;
}

#window-version {
    width: 8;
    content-align: right middle;
    color: $accent-cool;
}

#header {
    height: 7;
    width: 100%;
    background: $surface;
    border: round $border;
    padding: 0 1;
}

#ascii-logo {
    color: $accent;
    text-style: bold;
}

#status-line {
    width: 1fr;
    height: 5;
    padding-left: 1;
}

#tagline {
    color: $muted;
}

#status-line Static {
    color: $text;
}

#nav-bar {
    height: 3;
    width: 100%;
    background: $surface;
    border: round $border;
    padding: 0 1;
}

#nav-bar Button {
    background: transparent;
    color: $muted;
    border: none;
    min-width: 14;
    margin: 0 1;
}

#nav-bar Button:hover {
    color: $accent;
}

#nav-bar Button:focus {
    background: $surface-2;
    color: $accent;
    text-style: bold;
}

#nav-bar Button.-active {
    background: $surface-2;
    color: $accent;
    text-style: bold;
    border: round $accent;
}

#content {
    width: 100%;
    height: 1fr;
    background: $frame;
    padding: 1;
}

.panel-title {
    color: $accent;
    text-style: bold;
    background: $surface;
    padding: 0 1;
    border: round $border-strong;
}

.progress-label {
    color: $muted;
}

Button {
    color: $text;
    border: round $border;
    background: $surface;
}

.cta-row Button {
    min-width: 16;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#start-run {
    background: $success;
    color: $bg;
    border: round $success;
}

#stop-run {
    background: $danger;
    color: $bg;
    border: round $danger;
}

Input {
    height: 3;
    border: round $border;
    background: $surface;
    color: $text;
    padding: 0 1;
}

Input:focus {
    border: round $accent-cool;
}

#activity-log {
    height: 1fr;
    border: round $border;
    background: $surface;
    padding: 1;
}

DataTable {
    height: 1fr;
    background: $surface;
    border: round $border;
}

DataTable > .datatable--header {
    background: $surface-2;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent-strong;
    color: $bg;
}

#chat-log {
    height: 1fr;
    border: round $border;
    background: $surface;
    padding: 1;
    margin-bottom: 1;
}

#chat-input {
    height: 3;
    border: round $border-strong;
    background: $surface;
    color: $text;
}

#chat-input:focus {
    border: round $accent-cool;
}

.user-message {
    color: $accent;
    margin-bottom: 1;
}

.assistant-message {
    color: $text;
    margin-bottom: 1;
}

.empty-state {
    color: $muted;
    text-align: center;
    padding: 1;
}

#approval-modal,
#model-config-modal {
    align: center middle;
    width: 74;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#approval-modal .modal-title,
#model-config-modal Label {
    color: $accent;
    text-style: bold;
    text-align: center;
    padding-bottom: 1;
}

#approval-modal .modal-content {
    color: $text;
    padding: 1 0;
}

#approval-modal .modal-actions,
#model-config-modal .modal-actions {
    layout: horizontal;
    align: center middle;
    height: auto;
    padding-top: 1;
}

#approval-modal Button,
#model-config-modal Button {
    margin: 0 2;
    min-width: 12;
}

#approval-modal #approve-btn {
    background: $success;
    color: $bg;
    border: solid $success;
}

#approval-modal #reject-btn {
    background: $danger;
    color: $bg;
    border: solid $danger;
}

#approval-modal #details-btn {
    background: $surface-2;
    color: $accent;
    border: round $accent;
}

#footer {
    height: 3;
    width: 100%;
    background: $surface;
    border: round $border;
    padding: 0 1;
}

#footer Static {
    color: $muted;
}

.metric-label {
    color: $muted;
}

.metric-value {
    color: $accent;
    text-style: bold;
}

Scrollbar {
    background: $surface-2;
}

ScrollbarSlider {
    background: $border-strong;
}

ScrollbarSlider:hover {
    background: $accent;
}

LoadingIndicator {
    color: $accent;
}

.status-muted {
    color: $muted;
}

.status-ok {
    color: $success;
    text-style: bold;
}

.status-warn {
    color: $warning;
}

Tabs {
    display: none;
}

TabPane {
    padding: 1;
}
